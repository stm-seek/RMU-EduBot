# ============================================================================
#  LINE AI Academic Assistant — ตัวอย่าง environment variables
#  คัดลอกเป็น .env แล้วเติมค่าจริง  ( .env ถูก gitignore ไว้แล้ว )
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=rmubot
POSTGRES_PASSWORD=rmubot_dev_password
POSTGRES_DB=rmu_bot
POSTGRES_PORT=5432

# connection string ที่แอปใช้ (ต้องตรงกับค่าข้างบน)
# production: เปลี่ยน host เป็นของ managed DB และเพิ่ม ?sslmode=require
DATABASE_URL=postgresql://rmubot:rmubot_dev_password@127.0.0.1:5432/rmu_bot

# เวลารอตอนสตาร์ทให้ pool พร้อม (วินาที) — เกินนี้แอปจะทำงานต่อแบบไม่มี DB
# ตั้งสูงเผื่อ Neon/Supabase free tier ที่ต้อง cold start
# ตอน dev ที่ยังไม่มี DB ลดเป็น 2 จะสตาร์ทเร็วขึ้น
DB_CONNECT_TIMEOUT_SECONDS=10

# ── LINE Messaging API ──────────────────────────────────────────────────────
# หาได้จาก LINE Developers Console > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF app ID (LINE Login channel > LIFF tab) — ต้องเปิด scope 'openid'
LIFF_ID=
# LINE Login channel ID — ใช้ verify ID token (ต้องตรงกับ aud ใน token)
LINE_LOGIN_CHANNEL_ID=

# ── LLM (OpenAI-compatible) ─────────────────────────────────────────────────
# ออกแบบให้สลับ provider ได้ด้วย base_url + api_key เท่านั้น
#
# Gemini    : https://generativelanguage.googleapis.com/v1beta/openai
#             model: gemini-3.5-flash-lite (เร็ว 1 วิ) หรือ gemini-3.6-flash
#             (20 วิ เพราะเป็น thinking model) — สาย 2.x ถูกปลดแล้ว
#             (ยืนยันแล้วว่ารองรับ /chat/completions และ /embeddings)
# OpenAI    : https://api.openai.com/v1
#             model: gpt-4o-mini
# OpenRouter: https://openrouter.ai/api/v1
# Ollama    : http://127.0.0.1:11434/v1   (api_key ใส่อะไรก็ได้)
# vLLM      : http://127.0.0.1:8000/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# ยืนยันแล้ว 19 ส.ค. 2026 — สาย gemini-2.x ถูกปลดจาก API หมดแล้ว (404)
LLM_MODEL=gemini-3.5-flash-lite
# thinking model ตอบช้ากว่าที่คิด — วัดได้ 19.7 วิ สำหรับคำตอบไทยสั้น ๆ
LLM_TIMEOUT_SECONDS=60
# เผื่อ token ที่โมเดล thinking ใช้ไปกับการคิด ซึ่งไม่ถูกนับใน completion_tokens
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.3

# ── ทนต่อโมเดลโอเวอร์โหลด (503 high demand) ─────────────────────────────────
# Gemini free tier คืน 503 "This model is currently experiencing high demand"
# แบบสุ่มถี่มาก — วัดจริง 21 ส.ค. 2026: ยิง 7 ครั้ง ได้ 503 ในการยิงครั้งแรก
# ทั้ง 7 ครั้ง และผู้ใช้เห็นข้อความ "ระบบขัดข้อง" 4 ใน 7 ครั้ง
#
# โมเดลสำรอง (คอมมา-เซพาเรต, ตามลำดับที่จะลอง / ว่าง = ปิดฟีเจอร์)
# วัดแล้วว่า 503 เกิดแยกกันต่อโมเดล: นาทีเดียวกันที่ flash-lite 503
# gemini-3.1-flash-lite ตอบได้ปกติ จึงต้องสลับโมเดล ไม่ใช่ retry ตัวเดิมอย่างเดียว
# ยืนยันกับ API จริงแล้ว 21 ส.ค. 2026 ว่าสองตัวนี้ตอบไทยได้ (1.0 วิ / 4.2 วิ)
# ห้ามใส่ gemini-flash-lite-latest — เป็น alias ที่ 503 พร้อมโมเดลหลัก
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview
# เพดานเวลารวมของ retry + ไล่โมเดลสำรอง "ทั้งเชน" (ไม่รีเซ็ตต่อโมเดล)
# ต้องต่ำกว่าอายุ reply token ของ LINE — เกินแล้วต้องไปใช้ push ซึ่งกินโควตา
# ข้อความฟรี ตอบว่าขัดข้องเร็ว ๆ ดีกว่าให้นักศึกษารอเป็นนาที
LLM_RETRY_BUDGET_SECONDS=28

# ── Embedding (แยก provider ได้ ไม่ต้องเป็นตัวเดียวกับ LLM) ──────────────────
# สำคัญ: ต้องเป็น multilingual model — ภาษาไทยไม่มีเว้นวรรค
# model อังกฤษล้วนจะ retrieve ผิด
#
# Gemini : gemini-embedding-2  (default 3072 มิติ ขอ 768 ได้ / input 8192 token)
# OpenAI : text-embedding-3-small (1536 มิติ)
# BGE-M3 : bge-m3 ผ่าน Ollama/TEI (1024 มิติ) — รันเองฟรี รองรับไทยดี
#
# ค่านี้ต้องตรงกับ vector(N) ใน db/migrations/001_init.sql
# ถ้าเปลี่ยน model ต้อง ALTER คอลัมน์ + re-index ใหม่ทั้งหมด
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_API_KEY=
# text-embedding-004 ถูกปลดแล้ว ตัวที่ใช้ได้: gemini-embedding-2 (input 8192 token,
# ขอ 768 มิติได้เวกเตอร์ normalize มาแล้ว) หรือ gemini-embedding-001 (input 2048,
# ขอ 768 แล้วได้เวกเตอร์ยังไม่ normalize — ใช้กับ cosine ได้ แต่ไม่แนะนำ)
EMBEDDING_MODEL=gemini-embedding-2
# 768 ไม่ใช่ค่า default ของโมเดล (default = 3072) — app/llm.py ส่ง dimensions
# ไปขอตัดเหลือเท่านี้ ต้องตรงกับ vector(768) ใน db/migrations/001_init.sql
# เปลี่ยนค่านี้ต้อง ALTER คอลัมน์ + re-index ใหม่ทั้งหมด
EMBEDDING_DIM=768

# ── ความปลอดภัย ─────────────────────────────────────────────────────────────
# pepper สำหรับ hash line_user_id (SHA-256) — สุ่มยาว ๆ อย่างน้อย 32 ตัว
# สร้างด้วย: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ห้ามเปลี่ยนหลัง production เพราะ hash เดิมจะหาไม่เจอ
USER_ID_PEPPER=

# ── Retrieval / RAG ─────────────────────────────────────────────────────────
# ต่ำกว่านี้ถือว่าไม่มั่นใจ → ตอบ fallback ไม่เดา
FAQ_MATCH_THRESHOLD=0.82
RAG_SIMILARITY_THRESHOLD=0.55
RAG_TOP_K=5

# ── Scraper ─────────────────────────────────────────────────────────────────
SCRAPER_DELAY_SECONDS=1.0
SCRAPER_USE_CACHE=true
# หลักสูตรที่อยู่ใน scope (MDI 643170151)
DEFAULT_PROGRAM_ID=59721
DEFAULT_PROGRAM_CODE=643170151

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
# URL ภายนอกที่ LINE เรียกเข้ามา (ngrok/tailscale/โดเมนจริง)
# ต้องเป็น HTTPS และตั้งใน LINE Console > Webhook URL = <นี่>/webhook
PUBLIC_BASE_URL=
